# Source and dataset locations
LIBERO_ROOT=
LIBERO_DATA_DIR=
BRIDGE_DATA_DIR=data/bridge

# Model and world-model assets
SFT_MODEL_PATH=checkpoints/policy/pi05-bridge
WORLD_MODEL_PATH=../world_model/checkpoints/prophet/prophet-bridge.pt
# Prophet source is the sibling world_model component in this repository.
VAE_FOLDER=../world_model
PI05_BASE_TORCH_PATH=
PALIGEMMA_TOKENIZER_PATH=
# Optional Hugging Face dataset id. Leave empty to use BRIDGE_DATA_DIR/norm_stats.json.
BRIDGE_LEROBOT_REPO_ID=

# Optional paths for upstream Prismatic, DROID, PRIME, and generation workflows.
PRISMATIC_DATA_ROOT=data/prismatic-vlms
DROID_RLDS_DATA_DIR=
PRIME_MODEL_PATH=
PRIME_REF_PATH=
GENERATION_INPUT_PATH=
GENERATION_OUTPUT_PATH=outputs/generation.parquet
GENERATION_MODEL_PATH=

# Optional checkpoint merge inputs. They can also be passed as arguments.
LOAD_MODEL_PATH=
MERGED_OUT_PATH=
META_PATH=

# Runtime outputs
OUTPUT_DIR=work_dirs

# Optional experiment tracking. Set this only in your local environment.
WANDB_API_KEY=
REFERENCE_VIDEO_DIR=
